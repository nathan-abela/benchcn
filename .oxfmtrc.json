{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": [
    "public/r/",
    "registry.json",
    ".claude/",
    "src/routeTree.gen.ts",
    ".source/",
    "dist/",
    "pnpm-lock.yaml",
    ".agents/"
  ]
}
