// Generates src/styles/themes.css from shadcn's zinc base colour (scripts/themes/zinc.json,
// fetched from https://ui.shadcn.com/r/colors/zinc.json) and the Tailwind v4 oklch palette.
// The site uses zinc; components follow whatever base colour the installing project uses.
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const read = (name: string) => JSON.parse(readFileSync(join(here, "themes", name), "utf8"));

type Vars = Record<string, string>;
type BaseColor = { inlineColors: { light: Vars; dark: Vars } };

const palette: Record<string, Record<string, string>> = read("palette.json");
const zinc: BaseColor = read("zinc.json");

const block = (selector: string, vars: Vars) =>
  `${selector} {\n${Object.entries(vars)
    .map(([k, v]) => `  --${k}: ${v};`)
    .join("\n")}\n}\n`;

const semantic = {
  // Light status colours are used as text, so they keep 4.5:1 on white. Warning is amber-700
  // turned toward yellow, so it stays clearly apart from the red of --destructive.
  light: {
    success: palette.green[700],
    "success-foreground": palette.green[50],
    warning: "oklch(0.555 0.132 58)",
    "warning-foreground": palette.amber[50],
    "channel-1": "oklch(0.62 0.12 65)",
    "channel-2": "oklch(0.6 0.09 185)",
    "channel-3": "oklch(0.58 0.14 320)",
    "channel-4": "oklch(0.58 0.13 255)",
    "scope-screen": "oklch(0.19 0.004 80)",
  },
  dark: {
    success: palette.green[500],
    "success-foreground": palette.green[950],
    warning: palette.amber[400],
    "warning-foreground": palette.amber[950],
    "channel-1": "oklch(0.8 0.12 72)",
    "channel-2": "oklch(0.78 0.09 185)",
    "channel-3": "oklch(0.74 0.12 320)",
    "channel-4": "oklch(0.74 0.11 255)",
    "scope-screen": "oklch(0.15 0.004 80)",
  },
};

let css = `/* Generated by scripts/build-themes.mts. Do not edit by hand. */\n\n`;

css += block(":root", { ...zinc.inlineColors.light, ...semantic.light });
css += block(".dark", { ...zinc.inlineColors.dark, ...semantic.dark });

writeFileSync(join(here, "..", "src", "styles", "themes.css"), css);
console.log("themes.css: zinc");
