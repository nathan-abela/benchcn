// Generates src/styles/themes.css from shadcn's base colours (scripts/themes/*.json,
// fetched from https://ui.shadcn.com/r/colors/<name>.json) and the Tailwind v4 oklch palette.
// Neutral themes swap every token; colour themes keep the stone neutrals and swap the accent.
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const read = (name: string) => JSON.parse(readFileSync(join(here, "themes", name), "utf8"));

type Vars = Record<string, string>;
type BaseColor = { inlineColors: { light: Vars; dark: Vars } };

const neutrals = ["stone", "zinc", "neutral"] as const;
const accents = {
  blue: { light: 600, dark: 500 },
  green: { light: 600, dark: 500 },
  rose: { light: 600, dark: 500 },
  violet: { light: 600, dark: 500 },
  orange: { light: 600, dark: 500 },
} as const;

const palette: Record<string, Record<string, string>> = read("palette.json");
const base: Record<string, BaseColor> = Object.fromEntries(
  neutrals.map((n) => [n, read(`${n}.json`)]),
);

const block = (selector: string, vars: Vars) =>
  `${selector} {\n${Object.entries(vars)
    .map(([k, v]) => `  --${k}: ${v};`)
    .join("\n")}\n}\n`;

const semantic = {
  light: {
    success: palette.green[600],
    "success-foreground": palette.green[50],
    warning: palette.amber[500],
    "warning-foreground": palette.amber[950],
    "channel-1": "oklch(0.8 0.16 85)",
    "channel-2": "oklch(0.7 0.12 200)",
    "channel-3": "oklch(0.66 0.2 340)",
    "channel-4": "oklch(0.62 0.17 262)",
  },
  dark: {
    success: palette.green[500],
    "success-foreground": palette.green[950],
    warning: palette.amber[400],
    "warning-foreground": palette.amber[950],
    "channel-1": "oklch(0.88 0.17 92)",
    "channel-2": "oklch(0.84 0.12 200)",
    "channel-3": "oklch(0.76 0.2 340)",
    "channel-4": "oklch(0.72 0.16 262)",
  },
};

function accentVars(color: string, shade: number, mode: "light" | "dark"): Vars {
  const primary = palette[color][shade];
  const foreground = mode === "light" ? palette[color][50] : palette[color][950];
  return {
    primary,
    "primary-foreground": foreground,
    ring: palette[color][mode === "light" ? 400 : 600],
    "sidebar-primary": primary,
    "sidebar-primary-foreground": foreground,
    "sidebar-ring": palette[color][mode === "light" ? 400 : 600],
  };
}

let css = `/* Generated by scripts/build-themes.mts. Do not edit by hand. */\n\n`;

css += block(":root", { ...base.stone.inlineColors.light, ...semantic.light });
css += block(".dark", { ...base.stone.inlineColors.dark, ...semantic.dark });

for (const n of neutrals) {
  if (n === "stone") continue;
  css += `\n${block(`:root[data-theme="${n}"]`, base[n].inlineColors.light)}`;
  css += block(`.dark[data-theme="${n}"]`, base[n].inlineColors.dark);
}

for (const [color, shades] of Object.entries(accents)) {
  css += `\n${block(`:root[data-theme="${color}"]`, accentVars(color, shades.light, "light"))}`;
  css += block(`.dark[data-theme="${color}"]`, accentVars(color, shades.dark, "dark"));
}

writeFileSync(join(here, "..", "src", "styles", "themes.css"), css);
console.log(`themes.css: ${neutrals.length + Object.keys(accents).length} themes`);
